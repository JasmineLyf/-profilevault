{
  "manifest_version": 3,
  "name": "ProfileVault",
  "version": "0.2.1",
  "minimum_chrome_version": "120",
  "description": "本地加密个人资料库与确认式表单填写",
  "permissions": ["storage", "activeTab", "scripting"],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "打开 ProfileVault",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "incognito": "not_allowed",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'none'; base-uri 'none'; form-action 'none'; worker-src 'self'"
  }
}
